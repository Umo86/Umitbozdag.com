<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= p.name %> — <%= p.title %> · Exhibitions &amp; Events, London</title>
  <meta name="description" content="<%= p.name %>, <%= p.title %> at <%= p.company %>. <%= p.tagline %>">
  <meta property="og:title" content="<%= p.name %> — Exhibitions &amp; Events Operations, London">
  <meta property="og:description" content="<%= p.tagline %>">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if (!video.local) { %>
  <link rel="preconnect" href="https://videos.pexels.com">
  <link rel="preconnect" href="https://images.pexels.com">
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="is-loading" data-tone="<%= video.tone || 'duotone' %>">

  <div class="curtain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>
  <div class="progress" aria-hidden="true"></div>

  <header class="nav">
    <a href="#top" class="nav__brand" aria-label="<%= p.name %> — home">
      <span class="nav__mark">UB</span>
      <span class="nav__name"><%= p.name %></span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      <a href="#about">About</a>
      <a href="#expertise">Expertise</a>
      <a href="#shows">Shows</a>
      <a href="#journey">Journey</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="nav__right">
      <span class="nav__clock mono" aria-label="Local time in London">LDN <span data-clock>--:--</span> <span data-tz>GMT</span></span>
      <a href="#contact" class="nav__cta mono">Let’s talk <span aria-hidden="true">↗</span></a>
      <button class="nav__burger" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    </div>
  </header>

  <main id="top">

    <!-- ============ HERO ============ -->
    <section class="hero" id="home">
      <div class="hero__media" aria-hidden="true">
        <canvas class="hero__canvas"></canvas>
        <video class="hero__video" muted playsinline autoplay loop preload="metadata"
               poster="<%= video.poster || '/img/scenes/poster.jpg' %>"
               data-src-mobile="<%= video.sources.mobile %>"
               data-src-desktop="<%= video.sources.desktop %>"
               data-src-large="<%= video.sources.large %>"></video>
        <div class="hero__tint"></div>
        <div class="hero__lift"></div>
        <div class="hero__shade"></div>
      </div>

      <div class="hero__top container">
        <a class="hero__mail mono" href="mailto:<%= p.email %>"><%= p.email.toLowerCase() %></a>
        <p class="hero__tag mono"><%= p.tagline %></p>
      </div>

      <div class="hero__bottom container">
        <div class="hero__meta mono">
          <span><span class="live-dot"></span><%= p.availability %></span>
          <span><%= p.title %> · <%= p.company %></span>
          <span>London · <%= p.coords %></span>
        </div>
        <h1 class="hero__name" aria-label="<%= p.name %>">
          <span class="hero__word" data-split><%= p.firstName.toUpperCase() %></span>
          <span class="hero__word" data-split><%= p.lastName.toUpperCase() %></span>
        </h1>
      </div>
    </section>

    <!-- ============ TICKER ============ -->
    <div class="ticker" aria-label="Venues and cities">
      <div class="ticker__track">
        <% for (let i = 0; i < 2; i++) { p.ticker.forEach((t) => { %><span class="ticker__item"><%= t %></span><span class="ticker__sep">◆</span><% }); } %>
      </div>
    </div>

    <!-- ============ ABOUT ============ -->
    <section id="about" class="section about">
      <div class="container">
        <div class="section__bar"><span class="mono">// About me</span><span class="mono">© <%= year %> — London</span></div>
        <div class="about__statement">
          <h2 class="display reveal"><%= p.statement %></h2>
        </div>
        <div class="about__grid">
          <figure class="about__figure reveal">
            <img src="<%= p.portrait.image %>" alt="<%= p.portrait.alt %>" loading="lazy" width="1000" height="1250">
            <figcaption class="mono"><%= p.portrait.caption %></figcaption>
          </figure>
          <div class="about__side">
            <div class="about__trust reveal">
              <span class="mono">Worked with</span>
              <p><%= p.trustedBy.join(' · ') %></p>
            </div>
            <p class="about__intro reveal"><%= p.intro %></p>
            <div class="stats">
              <% p.stats.forEach((s, i) => { %>
                <div class="stat reveal" style="--d:<%= i * 0.08 %>s">
                  <span class="stat__plus" aria-hidden="true">+</span>
                  <strong class="stat__value"><span data-count="<%= s.value %>">0</span><%= s.suffix %></strong>
                  <span class="stat__label"><%= s.label %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ EXPERTISE ============ -->
    <section id="expertise" class="section expertise">
      <div class="container">
        <div class="section__bar"><span class="mono">// Expertise</span><span class="mono">Capabilities</span></div>
        <div class="section__head">
          <h2 class="display reveal">Running London’s biggest show floors — <em>and the world’s.</em></h2>
          <a href="#contact" class="btn magnetic reveal">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
        <div class="caps">
          <% p.capabilities.forEach((c, i) => { %>
            <article class="cap <%= c.wide ? 'cap--wide' : 'cap--tall' %> reveal" style="--d:<%= i * 0.08 %>s">
              <img class="cap__img" src="<%= c.image %>" alt="" loading="lazy">
              <div class="cap__top mono"><span><%= c.no %></span><span><%= c.kind %></span></div>
              <% if (c.wide) { %>
                <div class="cap__body">
                  <h3><%= c.title %></h3>
                  <p><%= c.text %></p>
                </div>
              <% } else { %>
                <h3 class="cap__vtitle"><%= c.title %></h3>
                <p class="cap__hover"><%= c.text %></p>
              <% } %>
            </article>
          <% }) %>
        </div>
        <ul class="chips reveal" aria-label="Also">
          <% p.alsoSkills.forEach((s) => { %><li><%= s %></li><% }) %>
        </ul>
      </div>
    </section>

    <!-- ============ SHOWS ============ -->
    <section id="shows" class="section shows">
      <div class="shows__word" aria-hidden="true" data-parallax>SHOWS</div>
      <div class="container">
        <div class="section__bar"><span class="mono">// Shows</span><span class="mono">Selected work</span></div>
        <div class="shows__grid">
          <% p.shows.forEach((s, i) => { %>
            <article class="show reveal" style="--d:<%= (i % 2) * 0.1 %>s">
              <div class="show__media">
                <img src="<%= s.image %>" alt="" loading="lazy">
                <span class="show__year mono"><%= s.year %></span>
                <span class="show__role mono"><%= s.role %></span>
              </div>
              <div class="show__cap">
                <div>
                  <h3><%= s.name %></h3>
                  <p class="mono"><%= s.where %></p>
                </div>
                <p class="show__text"><%= s.text %></p>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============ JOURNEY ============ -->
    <section id="journey" class="section journey">
      <div class="container">
        <div class="section__bar"><span class="mono">// Journey</span><span class="mono">2012 → today</span></div>
        <h2 class="display reveal">Fourteen years on the show floor, <em>one line.</em></h2>

        <div class="line" aria-label="Career timeline">
          <div class="line__track"><div class="line__fill"></div></div>
          <ol class="line__stations">
            <% [...p.experience].reverse().forEach((j, i) => { %>
              <li class="station<%= j.current ? ' station--here' : '' %>" style="--d:<%= 0.3 + i * 0.22 %>s">
                <span class="station__dot" aria-hidden="true"></span>
                <span class="station__year mono"><%= j.start %></span>
                <span class="station__name"><%= j.company.split(' — ')[0] %></span>
                <span class="station__role"><%= j.role %></span>
                <% if (j.current) { %><span class="station__here mono">You are here</span><% } %>
              </li>
            <% }) %>
          </ol>
        </div>

        <div class="jobs">
          <% p.experience.forEach((j, i) => { %>
            <details class="job reveal"<%= i === 0 ? ' open' : '' %>>
              <summary>
                <span class="job__period mono"><%= j.period %></span>
                <span class="job__role"><%= j.role %></span>
                <span class="job__co"><%= j.company %></span>
                <span class="job__plus" aria-hidden="true">+</span>
              </summary>
              <div class="job__body">
                <div>
                  <p class="job__summary"><%= j.summary %></p>
                  <ul class="job__points"><% j.points.forEach((pt) => { %><li><%= pt %></li><% }) %></ul>
                </div>
                <% if (j.events.length) { %>
                  <div class="job__events">
                    <span class="mono">Managed events</span>
                    <ul><% j.events.forEach((e) => { %><li><%= e %></li><% }) %></ul>
                  </div>
                <% } %>
              </div>
            </details>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============ WORK TOGETHER ============ -->
    <section id="work" class="section work">
      <div class="container">
        <div class="section__bar"><span class="mono">// Let’s work together</span><span class="mono"><%= p.availability %></span></div>
        <div class="work__grid">
          <div class="offer reveal">
            <div class="offer__head">
              <div>
                <h3><%= p.offer.title %></h3>
                <p class="mono offer__kicker"><%= p.offer.kicker %></p>
              </div>
              <div class="offer__tabs" role="tablist" aria-label="Event type">
                <% p.offer.tabs.forEach((t, i) => { %><button type="button" role="tab" aria-selected="<%= i === 0 %>" class="<%= i === 0 ? 'is-on' : '' %>"><%= t %></button><% }) %>
              </div>
            </div>
            <p class="mono offer__label">What’s included</p>
            <ul class="offer__list"><% p.offer.includes.forEach((it) => { %><li><%= it %></li><% }) %></ul>
            <div class="offer__foot">
              <div class="offer__figure">
                <strong><%= p.offer.figure.value %></strong>
                <span><%= p.offer.figure.unit %><br><%= p.offer.figure.note %></span>
              </div>
              <a href="#contact" class="btn magnetic"><%= p.offer.cta %> <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="avail reveal" style="--d:.1s">
            <div class="avail__top">
              <span class="avatar" aria-hidden="true">UB</span>
              <span class="chip chip--live"><span class="live-dot"></span><%= p.availability %></span>
            </div>
            <h3>Let’s build something great on the show floor.</h3>
            <p>Exhibitions, conferences and the operations behind them — in London, or wherever the show travels next.</p>
            <a href="#contact" class="btn btn--ghost magnetic">Get in touch <span aria-hidden="true">↗</span></a>
            <p class="avail__alt mono">Prefer email? <a href="mailto:<%= p.email %>"><%= p.email.toLowerCase() %></a></p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ WORLD MAP ============ -->
    <section id="world" class="section world">
      <div class="container">
        <div class="section__bar"><span class="mono">// World tour</span><span class="mono">From London</span></div>
        <div class="map reveal">
          <svg class="map__svg" viewBox="0 0 <%= map.width %> <%= map.height %>" role="img" aria-label="World map of event locations">
            <defs>
              <radialGradient id="glow"><stop offset="0" stop-color="#1a47ff" stop-opacity=".9"/><stop offset="1" stop-color="#1a47ff" stop-opacity="0"/></radialGradient>
            </defs>
            <g class="map__dots"><% map.dots.forEach((d) => { %><circle cx="<%= d[0] %>" cy="<%= d[1] %>" r="2.1"/><% }) %></g>
            <% const hq = map.cities.find((c) => c.hq); %>
            <g class="map__routes">
              <% map.cities.filter((c) => !c.hq).forEach((c, i) => {
                   const mx = (hq.x + c.x) / 2, my = Math.min(hq.y, c.y) - Math.hypot(c.x - hq.x, c.y - hq.y) * 0.35; %>
                <path d="M<%= hq.x %>,<%= hq.y %> Q<%= mx.toFixed(1) %>,<%= my.toFixed(1) %> <%= c.x %>,<%= c.y %>" style="--i:<%= i %>"/>
              <% }) %>
            </g>
            <g class="map__cities">
              <% map.cities.forEach((c, i) => { %>
                <g class="city<%= c.hq ? ' city--hq' : '' %>" style="--i:<%= i %>" transform="translate(<%= c.x %>,<%= c.y %>)">
                  <circle class="city__glow" r="18" fill="url(#glow)"/>
                  <circle class="city__pulse" r="5"/>
                  <circle class="city__dot" r="4"/>
                </g>
              <% }) %>
            </g>
          </svg>
          <div class="map__labels">
            <% map.cities.forEach((c, i) => {
                 const mods = (c.label || '').split(' ').filter(Boolean).map((m) => ' map__label--' + m).join(''); %>
              <span class="map__label<%= c.hq ? ' map__label--hq' : '' %><%= mods %>" style="left:<%= (c.x / map.width * 100).toFixed(2) %>%;top:<%= (c.y / map.height * 100).toFixed(2) %>%;--i:<%= i %>"><%= c.name %></span>
            <% }) %>
          </div>
        </div>
        <p class="map__caption mono">Shows delivered or supported across five continents — London, Birmingham, Milan, Rotterdam, Istanbul, New Delhi, Houston, Dublin &amp; Cape Town.</p>
      </div>
    </section>

    <!-- ============ SHOW LOG ============ -->
    <section id="log" class="section log">
      <div class="container">
        <div class="section__bar"><span class="mono">// Show log</span><span class="mono">Recent</span></div>
        <div class="log__grid">
          <% p.log.forEach((l, i) => { %>
            <article class="logcard reveal" style="--d:<%= i * 0.08 %>s">
              <div class="logcard__media"><img src="<%= l.image %>" alt="" loading="lazy"></div>
              <div class="logcard__meta mono"><span><%= l.date %></span><span><%= l.venue %></span></div>
              <h3><%= l.title %></h3>
            </article>
          <% }) %>
        </div>
        <div class="creds reveal">
          <% p.credentials.forEach((c) => { %><div class="cred"><strong><%= c.title %></strong><span><%= c.text %></span></div><% }) %>
        </div>
      </div>
    </section>

    <% if (p.testimonials && p.testimonials.length) { %>
    <!-- ============ TESTIMONIALS ============ -->
    <section id="testimonials" class="section testimonials">
      <div class="container">
        <div class="section__bar"><span class="mono">// Testimonials</span><span class="mono">Trusted</span></div>
        <h2 class="display reveal">Words from the people <em>I’ve built shows with.</em></h2>
        <div class="quotes">
          <% p.testimonials.forEach((t, i) => { %>
            <blockquote class="quote reveal" style="--d:<%= (i % 3) * 0.08 %>s">
              <p>“<%= t.quote %>”</p>
              <footer><strong><%= t.name %></strong><span><%= t.role %></span></footer>
            </blockquote>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="section contact">
      <div class="container contact__grid">
        <div class="contact__copy">
          <span class="mono section__num">// Contact</span>
          <h2 class="display reveal">Planning a show in London — <em>or anywhere else?</em></h2>
          <p class="reveal">Let’s talk about exhibitions, conferences, operations leadership and the tools that make events run better.</p>
          <ul class="contact__links reveal">
            <li><span class="mono">Email</span><a href="mailto:<%= p.email %>"><%= p.email.toLowerCase() %></a></li>
            <% if (p.phone) { %><li><span class="mono">Phone</span><a href="tel:<%= p.phone.replace(/[^+\d]/g, '') %>"><%= p.phone %></a></li><% } %>
            <li><span class="mono">LinkedIn</span><a href="<%= p.linkedin %>" target="_blank" rel="noopener">in/umit-bozdag ↗</a></li>
            <li><span class="mono">Based</span><span><%= p.area %></span></li>
          </ul>
        </div>

        <form class="cform reveal" novalidate>
          <div class="cform__head mono"><span>Send a message</span><span data-clock-long>London, <span data-clock>--:--</span></span></div>
          <label class="field"><input name="name" required placeholder=" " autocomplete="name"><span>Your name</span></label>
          <label class="field"><input name="email" type="email" required placeholder=" " autocomplete="email"><span>Email</span></label>
          <label class="field"><input name="company" placeholder=" " autocomplete="organization"><span>Company (optional)</span></label>
          <label class="field"><textarea name="message" rows="4" required placeholder=" "></textarea><span>How can I help?</span></label>
          <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn--block magnetic" type="submit"><span class="btn__label">Send message</span> <span aria-hidden="true">↗</span></button>
          <p class="cform__status" role="status" aria-live="polite"></p>
          <div class="cform__done" aria-hidden="true">
            <span class="mono">Message received</span>
            <strong class="cform__thanks">Thanks!</strong>
            <span>I’ll be in touch shortly.</span>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__top">
      <div class="footer__col">
        <span class="mono">Menu</span>
        <a href="#about">About</a><a href="#expertise">Expertise</a><a href="#shows">Shows</a><a href="#journey">Journey</a><a href="#contact">Contact</a>
      </div>
      <div class="footer__col">
        <span class="mono">Contact</span>
        <a href="mailto:<%= p.email %>"><%= p.email.toLowerCase() %></a>
        <a href="<%= p.linkedin %>" target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
      <div class="footer__col">
        <span class="mono">Location</span>
        <span><%= p.area %></span>
        <span><%= p.coords %></span>
        <span>Local time <span data-clock>--:--</span> <span data-tz>GMT</span></span>
      </div>
      <div class="footer__col">
        <span class="mono">Credits</span>
        <span>Header film: <a href="<%= video.page %>" target="_blank" rel="noopener">“<%= video.title %>” via <%= video.credit %></a></span>
        <span>Illustrated London scenes generated in-house</span>
      </div>
    </div>

    <div class="footer__giant" aria-hidden="true">
      <svg class="skyline" viewBox="0 0 1200 140" preserveAspectRatio="xMidYMax meet">
        <g fill="#1c1e26">
          <rect x="36" y="40" width="10" height="88"/><rect x="31" y="62" width="20" height="10"/>
          <rect x="100" y="92" width="150" height="36"/><rect x="100" y="56" width="24" height="72"/><polygon points="168,92 176,70 184,92"/>
          <rect x="236" y="50" width="14" height="78"/><polygon points="234,50 243,28 252,50"/>
          <polygon points="300,128 330,72 360,128 352,128 330,86 308,128"/>
          <rect x="420" y="100" width="70" height="28"/><path d="M430 100 A25 25 0 0 1 480 100 Z"/><rect x="452" y="66" width="6" height="12"/>
          <rect x="560" y="48" width="16" height="80"/><rect x="585" y="30" width="30" height="98"/>
          <path d="M625 128 C625 70 633 46 645 46 C657 46 665 70 665 128 Z"/>
          <polygon points="672,128 700,44 700,128"/><rect x="708" y="50" width="16" height="78"/>
          <path d="M735 128 L731 68 Q755 56 779 68 L775 128 Z"/>
          <polygon points="800,128 826,10 852,128"/>
          <rect x="900" y="34" width="20" height="94"/><rect x="990" y="34" width="20" height="94"/>
          <polygon points="898,34 910,18 922,34"/><polygon points="988,34 1000,18 1012,34"/>
          <rect x="920" y="56" width="70" height="5"/><rect x="920" y="70" width="70" height="5"/><rect x="870" y="104" width="170" height="6"/>
          <rect x="1080" y="60" width="22" height="68"/><rect x="1110" y="46" width="28" height="82"/><polygon points="1110,46 1124,32 1138,46"/><rect x="1146" y="64" width="20" height="64"/>
          <rect x="0" y="128" width="1200" height="12"/>
        </g>
        <g fill="none" stroke="#1c1e26" stroke-width="4"><circle cx="330" cy="72" r="46"/></g>
        <rect x="0" y="127" width="1200" height="1.5" fill="rgba(26,71,255,.7)"/>
      </svg>
      <div class="footer__word"><span>U</span><span>M</span><span>I</span><span>T</span></div>
    </div>

    <div class="container footer__bottom">
      <span>© <%= year %> <%= p.name %>. All rights reserved.</span>
      <span class="mono">Made in London</span>
      <a href="#top" class="footer__up">Back to top ↑</a>
    </div>
  </footer>

  <script src="/js/london-scene.js" defer></script>
  <script src="/js/main.js" defer></script>
</body>
</html>

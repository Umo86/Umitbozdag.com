<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= p.name %> — <%= p.title %> · Exhibitions &amp; Events, London</title>
  <meta name="description" content="<%= p.name %>, <%= p.title %> at <%= p.company %>. <%= p.statement %>">
  <meta property="og:title" content="<%= p.name %> — Exhibitions &amp; Events Operations, London">
  <meta property="og:description" content="<%= p.statement %>">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if (!video.local) { %>
  <link rel="preconnect" href="https://videos.pexels.com">
  <link rel="preconnect" href="https://images.pexels.com">
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<%
  const logoFor = (key) => (key && logos && logos[key]) || null;
  const logoOf = (x) => (x && x.logoUrl) || logoFor(x && x.logo);
  const initials = (name) => name.replace(/[^A-Za-z0-9 &]/g, '').split(/\s+/).filter(Boolean).slice(0, 3).map((w) => w[0]).join('').toUpperCase();
  const showCount = p.shows.length;
  const countryStat = (p.stats || []).find((x) => /countr/i.test(x.label));
  const countries = countryStat ? countryStat.value : new Set(p.shows.map((s) => s.country).filter((c) => c && !/various|multiple/i.test(c))).size;
  const intro = Array.isArray(p.intro) ? p.intro : [p.intro];
  const byOrg = (id) => p.shows.filter((s) => s.organiser === id).length;
  const waHref = p.whatsapp ? `https://wa.me/${p.whatsapp}?text=${encodeURIComponent(p.whatsappText || '')}` : null;
  const waIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z"/><path d="M9.2 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .6a6.8 6.8 0 0 0 3 2.8c.3.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.9.9c.3.1.4.2.4.4a2.4 2.4 0 0 1-1.8 2.3c-1 .2-2.3-.1-4.1-1.3a10.5 10.5 0 0 1-3.6-4c-.6-1.2-.5-2.2-.1-2.9z" fill="currentColor" stroke="none"/></svg>';
%>
<body data-tone="<%= video.tone || 'duotone' %>">

  <header class="nav">
    <div class="wrap">
      <a href="#top" class="nav__brand"><%= p.name %></a>
      <nav class="nav__links" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#services">What I do</a>
        <a href="#events">Events</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="nav__burger" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-label="Introduction">
      <div class="hero__media" aria-hidden="true">
        <canvas class="hero__canvas"></canvas>
        <video class="hero__video" muted playsinline autoplay loop preload="metadata"
               poster="<%= video.poster || '/img/scenes/poster.jpg' %>"
               data-src-mobile="<%= (video.sources || {}).mobile || '' %>"
               data-src-desktop="<%= (video.sources || {}).desktop || '' %>"
               data-src-large="<%= (video.sources || {}).large || '' %>"></video>
        <div class="hero__tint"></div>
        <div class="hero__lift"></div>
        <div class="hero__shade"></div>
      </div>
      <div class="wrap">
        <p class="hero__eyebrow"><%= p.title %> · <%= p.company %> · London</p>
        <h1><%= p.firstName %><br><%= p.lastName %></h1>
      </div>
    </section>

    <section class="world" aria-label="Where I have worked">
      <div class="wrap">
        <div class="map">
          <svg class="map__svg" viewBox="0 0 <%= map.width %> <%= map.height %>" role="img" aria-label="World map of event locations">
            <defs><radialGradient id="glow"><stop offset="0" stop-color="#1a47ff" stop-opacity=".9"/><stop offset="1" stop-color="#1a47ff" stop-opacity="0"/></radialGradient></defs>
            <g class="map__dots"><% map.dots.forEach((d) => { %><circle cx="<%= d[0] %>" cy="<%= d[1] %>" r="2.1"/><% }) %></g>
            <% const hq = map.cities.find((c) => c.hq); %>
            <g class="map__routes">
              <% if (hq) map.cities.filter((c) => !c.hq).forEach((c, i) => { const mx = (hq.x + c.x) / 2, my = Math.min(hq.y, c.y) - Math.hypot(c.x - hq.x, c.y - hq.y) * 0.35; %>
                <path d="M<%= hq.x %>,<%= hq.y %> Q<%= mx.toFixed(1) %>,<%= my.toFixed(1) %> <%= c.x %>,<%= c.y %>" style="--i:<%= i %>"/>
              <% }) %>
            </g>
            <g class="map__cities">
              <% map.cities.forEach((c, i) => { %>
                <g class="city<%= c.hq ? ' city--hq' : '' %>" style="--i:<%= i %>" transform="translate(<%= c.x %>,<%= c.y %>)"><circle class="city__glow" r="18" fill="url(#glow)"/><circle class="city__pulse" r="5"/><circle class="city__dot" r="4"/></g>
              <% }) %>
            </g>
          </svg>
          <div class="map__labels">
            <% map.cities.forEach((c, i) => { const mods = (c.label || '').split(' ').filter(Boolean).map((m) => ' map__label--' + m).join(''); %>
              <span class="map__label<%= c.hq ? ' map__label--hq' : '' %><%= mods %>" style="left:<%= (c.x / map.width * 100).toFixed(2) %>%;top:<%= (c.y / map.height * 100).toFixed(2) %>%;--i:<%= i %>"><%= c.name %></span>
            <% }) %>
          </div>
        </div>
        <div class="world__copy">
          <h2>From London to <%= countries === 8 ? 'eight' : countries %> countries.</h2>
          <p>Shows delivered or supported across the UK, the Netherlands, Italy, Türkiye, India, the United States, Ireland and South Africa.</p>
          <div class="world__nums">
            <% p.stats.forEach((s) => { %><div><strong><%= s.value %><%= s.suffix %></strong><span><%= s.label %></span></div><% }) %>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="sec">
      <div class="wrap">
        <div class="about">
          <div><span class="kicker">About</span><h2 class="h2"><%= p.statement %></h2></div>
          <div class="about__text"><% intro.forEach((para) => { %><p><%= para %></p><% }) %></div>
        </div>
        <dl class="facts">
          <% p.facts.forEach((f) => { %><div><dt class="label"><%= f.label %></dt><dd><%= f.value %></dd></div><% }) %>
        </dl>
        <div class="orgs">
          <span class="label">Worked with</span>
          <div class="orgs__grid">
            <% p.employers.forEach((e) => { const lg = logoOf(e); %>
              <a class="org" href="#events" data-filter-link="<%= e.id %>" title="See the <%= byOrg(e.id) %> event<%= byOrg(e.id) === 1 ? '' : 's' %>">
                <span class="org__logo"><% if (lg) { %><img src="<%= lg %>" alt="<%= e.name %>" loading="lazy"><% } else { %><span class="wordmark"><%= e.name %></span><% } %></span>
                <strong><%= e.name %></strong>
                <span><%= e.role %> · <%= e.period %></span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="sec" style="padding-top:0">
      <div class="wrap">
        <span class="kicker">What I do</span>
        <h2 class="h2" style="max-width:16ch"><%= p.servicesIntro %></h2>
        <div class="services">
          <% p.services.forEach((s, i) => { %><div class="svc"><em>0<%= i + 1 %></em><h3><%= s.title %></h3><p><%= s.text %></p></div><% }) %>
        </div>
      </div>
    </section>

    <section id="events" class="sec" style="padding-top:0">
      <div class="wrap">
        <div class="head">
          <div><span class="kicker">Events</span><h2 class="h2">Every show since 2012.</h2></div>
          <p class="meta"><%= showCount %> shows · <%= countries %> countries · newest first</p>
        </div>
        <div class="filters" role="group" aria-label="Filter events by organiser">
          <button type="button" class="is-on" data-filter="all" aria-pressed="true">All <span><%= showCount %></span></button>
          <% p.employers.forEach((e) => { %><button type="button" data-filter="<%= e.id %>" aria-pressed="false"><%= e.name %> <span><%= byOrg(e.id) %></span></button><% }) %>
        </div>
        <ul class="evt-grid">
          <% p.shows.forEach((s) => { const lg = logoOf(s); const org = p.employers.find((e) => e.id === s.organiser); %>
            <li data-org="<%= s.organiser %>">
              <a class="evt" href="/shows/<%= s.id %>">
                <span class="evt__logo"><% if (lg) { %><img src="<%= lg %>" alt="" loading="lazy"><% } else { %><span class="initials"><%= initials(s.name) %></span><% } %></span>
                <span><strong><%= s.name %></strong><span class="evt__where"><%= [s.venue, s.city].filter(Boolean).join(', ') %><%= org ? ' · ' + org.name : '' %></span></span>
                <span class="evt__year"><%= s.years || '' %></span>
                <span class="evt__arr" aria-hidden="true">→</span>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </section>

    <section id="contact" class="sec contact">
      <div class="wrap">
        <div>
          <span class="kicker">Contact</span>
          <h2 class="h2">Let’s talk.</h2>
          <p class="contact__lead">Planning a show, hiring, or want to compare notes? WhatsApp is the quickest way to reach me.</p>
          <div class="btns">
            <% if (waHref) { %><a class="btn" href="<%= waHref %>" target="_blank" rel="noopener"><%- waIcon %>Message on WhatsApp</a><% } %>
            <a class="btn btn--o" href="mailto:<%= p.email %>">Email me</a>
          </div>
          <p class="contact__small"><a href="mailto:<%= p.email %>"><%= p.email %></a> · <a href="<%= p.linkedin %>" target="_blank" rel="noopener">LinkedIn</a> · <%= p.area %><% if (p.phone) { %> · <a href="tel:<%= p.phone.replace(/[^+\d]/g, '') %>"><%= p.phone %></a><% } %></p>
        </div>
        <form class="cform" novalidate>
          <label class="field"><span>Your name</span><input name="name" required autocomplete="name"></label>
          <label class="field"><span>Email</span><input name="email" type="email" required autocomplete="email"></label>
          <label class="field field--full"><span>Company (optional)</span><input name="company" autocomplete="organization"></label>
          <label class="field field--full"><span>How can I help?</span><textarea name="message" rows="4" required></textarea></label>
          <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <div class="cform__actions"><button class="btn" type="submit"><span class="btn__label">Send message</span></button><span class="cform__status" role="status" aria-live="polite"></span></div>
          <div class="cform__done" aria-hidden="true"><strong class="cform__thanks">Thanks!</strong><span>I’ll be in touch shortly.</span></div>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <span>© <%= year %> <%= p.name %> · Web design by <%= p.name %> — all rights reserved.</span>
      <nav aria-label="Footer"><a href="<%= p.linkedin %>" target="_blank" rel="noopener">LinkedIn</a><a href="/privacy">Privacy</a><a href="#top">Top ↑</a></nav>
    </div>
  </footer>

  <% if (waHref) { %>
  <a class="wa" href="<%= waHref %>" target="_blank" rel="noopener" aria-label="Chat with <%= p.firstName %> on WhatsApp"><%- waIcon %><span class="wa__label">Let’s chat</span></a>
  <div class="wa-bubble" role="status">
    <button type="button" class="wa-bubble__close" aria-label="Dismiss">×</button>
    <strong>Hey, let’s talk.</strong>
    <a href="<%= waHref %>" target="_blank" rel="noopener">Message me on WhatsApp →</a>
  </div>
  <% } %>

  <div class="consent" hidden role="dialog" aria-modal="true" aria-labelledby="consent-title">
    <div class="consent__box">
      <div class="consent__step consent__step--ask">
        <span class="kicker" style="margin-bottom:0">Before you continue</span>
        <h2 id="consent-title">This site records basic visitor details.</h2>
        <p>When you browse umitbozdag.com I record your <strong>IP address</strong>, <strong>browser type</strong> and approximate <strong>location (country and city)</strong>, so I can see who visits. Nothing is sold or passed to advertisers. Details are in the <a href="/privacy">privacy notice</a>.</p>
        <div class="consent__actions">
          <button type="button" class="btn" data-consent="agree">I agree — continue</button>
          <button type="button" class="btn btn--o" data-consent="decline">I don’t agree</button>
        </div>
      </div>
      <div class="consent__step consent__step--no">
        <span class="kicker" style="margin-bottom:0">No problem</span>
        <h2>Without your agreement this site can’t be browsed.</h2>
        <p>You’re still welcome to get in touch directly: <a href="mailto:<%= p.email %>"><%= p.email %></a><% if (waHref) { %> or <a href="<%= waHref %>" target="_blank" rel="noopener">WhatsApp</a><% } %>.</p>
        <div class="consent__actions"><button type="button" class="btn" data-consent="back">Go back</button></div>
      </div>
    </div>
  </div>
  <script src="/js/london-scene.js" defer></script>
  <script src="/js/main.js" defer></script>
</body>
</html>

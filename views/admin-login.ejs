<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in — <%= p.name %> admin</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= base %>/assets/admin.css">
</head>
<body class="login">
  <main class="login__card">
    <div class="brand"><span class="mark">UB</span><div><strong><%= p.name %></strong><span>Site admin</span></div></div>
    <% if (mode === 'disabled') { %>
      <h1>Admin is switched off</h1>
      <p>Set an <code>ADMIN_PASSWORD</code> environment variable on this host (or make the data folder writable so a password can be stored), then reload this page.</p>
    <% } else if (mode === 'setup') { %>
      <h1>Choose your admin password</h1>
      <p>First visit — pick a password of at least 10 characters. You’ll use it to sign in from now on.</p>
      <% if (error) { %><p class="login__error" role="alert"><%= error %></p><% } %>
      <form method="post" action="<%= base %>/setup">
        <label>Password<input type="password" name="password" minlength="10" required autocomplete="new-password" autofocus></label>
        <label>Repeat password<input type="password" name="again" minlength="10" required autocomplete="new-password"></label>
        <button class="btn" type="submit">Save password &amp; sign in</button>
      </form>
    <% } else { %>
      <h1>Sign in</h1>
      <% if (error) { %><p class="login__error" role="alert"><%= error %></p><% } %>
      <form method="post" action="<%= base %>/login">
        <label>Password<input type="password" name="password" required autocomplete="current-password" autofocus></label>
        <button class="btn" type="submit">Sign in</button>
      </form>
    <% } %>
    <p class="login__back"><a href="/">← Back to the site</a></p>
  </main>
</body>
</html>
